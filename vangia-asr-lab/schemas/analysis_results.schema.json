{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vangia analysis bundle 1.0",
  "type": "object",
  "required": ["schema_version", "scientific_status", "runs", "samples", "groups", "transcripts", "latency_observations", "resources", "failures", "provenance"],
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["value", "unit", "definition_version", "scope", "numerator", "denominator", "n_total", "n_observed", "coverage", "evidence_class", "measurement_status", "missing_reason"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "numerator": {"type": ["number", "null"]},
        "denominator": {"type": ["number", "null"]},
        "n_total": {"type": "integer", "minimum": 0},
        "n_observed": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "measurement_status": {"enum": ["available", "missing"]},
        "missing_reason": {"type": ["string", "null"]}
      }
    },
    "row": {"type": "object", "required": ["benchmark_id", "run_id", "model_config_id", "repeat_id", "dataset_hash"]}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "scientific_status": {"const": "INSUFFICIENT EVIDENCE"},
    "runs": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/row"}], "required": ["planned", "completed", "metrics"], "properties": {"metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}}}}},
    "samples": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/row"}], "required": ["sample_id", "status", "scored", "missing_reason"]}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "transcripts": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "latency_observations": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  }
}
